<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ro.upt.pcbe</groupId>
    <artifactId>javabourse</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>JavaBourse</name>
    <description>Concurrent stock exchange simulation (PCBE/CEBP lab, stage 1)</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <!-- Tests tagged "faulty" prove that the broken variants are broken.
             They are excluded from the default build; run them with -Pfaulty. -->
        <surefire.excludedGroups>faulty</surefire.excludedGroups>
        <surefire.groups></surefire.groups>
    </properties>

    <dependencies>
        <!-- Test-only dependency. The application itself uses only the JDK. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>javabourse</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                    <groups>${surefire.groups}</groups>
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>ro.upt.pcbe.bursa.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- mvn test -Pfaulty : runs ONLY the tests that demonstrate the bugs. -->
            <id>faulty</id>
            <properties>
                <surefire.excludedGroups></surefire.excludedGroups>
                <surefire.groups>faulty</surefire.groups>
            </properties>
        </profile>
    </profiles>
</project>
